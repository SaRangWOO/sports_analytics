# 로그 파일 차단 (가장 중요!)
*.log
**/logs/

# 파이썬 가상환경 및 캐시
__pycache__/
*.py[cod]
venv/
.env

# 운영체제 생성 파일
.DS_Store
Thumbs.db
# Local runtime data
baseball/pg_data/
baseball/metabase_data/
kbo_analytics/pg_data/
kbo_analytics/metabase_data/
kbo_analytics/.venv/
**/.ipynb_checkpoints/

# Generated model artifacts stay on trusted operating storage.
kbo_analytics/modeling/artifacts/candidate/*
!kbo_analytics/modeling/artifacts/candidate/.gitkeep
kbo_analytics/modeling/artifacts/production/*
!kbo_analytics/modeling/artifacts/production/.gitkeep
kbo_analytics/modeling/artifacts/previous/*
!kbo_analytics/modeling/artifacts/previous/.gitkeep
kbo_analytics/modeling/artifacts/.promote-*
kbo_analytics/modeling/artifacts/.rollback-*

# KBO automation runtime and isolated outputs
kbo_analytics/runtime/
kbo_analytics/shadow/
kbo_analytics/quarantine/
kbo_analytics/backups/
reports/pitching_snapshot_recovery_audit/
