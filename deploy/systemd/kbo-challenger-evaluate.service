[Unit]
Description=KBO challenger artifact evaluation
After=network-online.target

[Service]
Type=oneshot
User=wsr
WorkingDirectory=/home/wsr/1.project/1.sports_analytics/kbo_analytics
EnvironmentFile=-/etc/kbo-automation.env
ExecStart=/home/wsr/1.project/1.sports_analytics/kbo_analytics/.venv/bin/python scripts/kbo_automation.py challenger-evaluate --json
TimeoutStartSec=7200
Restart=no
