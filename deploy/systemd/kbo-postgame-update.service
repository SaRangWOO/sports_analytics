[Unit]
Description=KBO postgame evaluation update
After=network-online.target

[Service]
Type=oneshot
User=wsr
WorkingDirectory=/home/wsr/1.project/1.sports_analytics/kbo_analytics
EnvironmentFile=-/etc/kbo-automation.env
ExecStart=/home/wsr/1.project/1.sports_analytics/kbo_analytics/.venv/bin/python scripts/kbo_automation.py postgame-update --json
TimeoutStartSec=1200
Restart=no
