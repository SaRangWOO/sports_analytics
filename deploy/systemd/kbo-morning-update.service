[Unit]
Description=KBO morning data and predict-only update
After=network-online.target

[Service]
Type=oneshot
User=wsr
WorkingDirectory=/home/wsr/1.project/1.sports_analytics/kbo_analytics
EnvironmentFile=-/etc/kbo-automation.env
ExecStart=/home/wsr/1.project/1.sports_analytics/kbo_analytics/.venv/bin/python scripts/kbo_automation.py morning-update --json
TimeoutStartSec=1800
Restart=no
